generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  SOLD
  ARCHIVED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

model AdminUser {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  phone           String?
  profileImage    String?
  passwordHash    String
  isSuperAdmin    Boolean   @default(false)
  allowedPages    Json      @default("[]")
  customerId      String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  customer        Customer? @relation("CustomerManagers", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

model Property {
  id                String          @id @default(cuid())
  title             String
  slug              String          @unique
  shortDescription  String?
  description       String
  price             Decimal         @db.Decimal(14, 2)
  currency          String          @default("EUR")
  city              String
  neighborhood      String?
  address           String
  latitude          Float
  longitude         Float
  propertyType      String?
  bedrooms          Int?
  bathrooms         Int?
  areaSqm           Float?
  floor             Int?
  unitNumber        String?
  parking           Boolean         @default(false)
  balcony           Boolean         @default(false)
  swimmingPool      Boolean         @default(false)
  elevator          Boolean         @default(false)
  fireplace         Boolean         @default(false)
  coolingType       String?
  heatingType       String?
  videoUrl          String?
  websiteUrl        String?
  sellerName        String
  sellerEmail       String
  sellerPhone       String
  status            PropertyStatus  @default(DRAFT)
  published         Boolean         @default(false)
  featured          Boolean         @default(false)
  sold              Boolean         @default(false)
  apiEnabled        Boolean         @default(false)
  metaTitle         String?
  metaDescription   String?
  projectId         String?
  customerId        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  images            PropertyImage[]
  inquiries         Inquiry[]
  projectUnits      ProjectUnit[]
  project           Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customer          Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([city])
  @@index([published, status])
  @@index([featured])
  @@index([projectId])
  @@index([customerId])
  @@index([apiEnabled, published, status])
}

model ImageBank {
  id        String   @id @default(cuid())
  url       String
  altText   String?
  tags      String?
  createdAt DateTime @default(now())
}

model PropertyImage {
  id          String   @id @default(cuid())
  propertyId  String
  url         String
  altText     String?
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model Project {
  id                String         @id @default(cuid())
  title             String
  slug              String         @unique
  shortDescription  String?
  description       String
  city              String
  address           String
  latitude          Float
  longitude         Float
  developerName     String
  completionDate    String?
  totalUnits        Int?
  videoUrl          String?
  websiteUrl        String?
  status            ProjectStatus  @default(DRAFT)
  published         Boolean        @default(false)
  featured          Boolean        @default(false)
  apiEnabled        Boolean        @default(false)
  metaTitle         String?
  metaDescription   String?
  environmentExrUrl String?
  customerId        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  images            ProjectImage[]
  documents         ProjectDocument[]
  properties        Property[]
  units             ProjectUnit[]
  inquiries         Inquiry[]
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([city])
  @@index([published, status])
  @@index([customerId])
  @@index([apiEnabled, published, status])
}

model ProjectUnit {
  id          String    @id @default(cuid())
  projectId   String
  building    String    @default("1")
  entrance    String    @default("A")
  floor       Int       @default(0)
  unitNumber  String
  propertyId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([projectId, building, entrance, floor])
  @@index([propertyId])
}

model ProjectDocument {
  id          String   @id @default(cuid())
  projectId   String
  url         String
  fileName    String
  fileType    String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model ProjectImage {
  id          String   @id @default(cuid())
  projectId   String
  url         String
  altText     String?
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model Inquiry {
  id         String   @id @default(cuid())
  propertyId String
  projectId  String?
  fullName   String
  email      String
  phone      String?
  message    String
  status     String   @default("new")
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notes      InquiryNote[]
  appointments Appointment[]
  emails     EmailLog[]

  @@index([propertyId, createdAt])
  @@index([projectId])
  @@index([status])
}

model InquiryNote {
  id         String   @id @default(cuid())
  inquiryId  String
  content    String
  createdBy  String?
  createdAt  DateTime @default(now())
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
}

model Appointment {
  id         String   @id @default(cuid())
  inquiryId  String
  dateTime   DateTime
  summary    String
  status     String   @default("scheduled")
  createdAt  DateTime @default(now())
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, dateTime])
}

model EmailLog {
  id         String   @id @default(cuid())
  inquiryId  String
  subject    String
  body       String
  sentTo     String
  sentAt     DateTime @default(now())
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, sentAt])
}

model HeroImage {
  id        String   @id @default(cuid())
  url       String
  altText   String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([active, sortOrder])
}

model ApiClient {
  id                    String    @id @default(cuid())
  name                  String
  description           String?
  tokenHash             String    @unique
  tokenPrefix           String
  active                Boolean   @default(true)
  scopeType             String    @default("all")
  customerId            String?
  allowedPropertyFields Json
  allowedProjectFields  Json
  includeImages         Boolean   @default(false)
  includeDocuments      Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  customer              Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

model Customer {
  id            String      @id @default(cuid())
  companyName   String
  logoUrl       String?
  description   String?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  projects      Project[]
  properties    Property[]
  managers      AdminUser[] @relation("CustomerManagers")
  apiClients    ApiClient[]

  @@index([companyName])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
