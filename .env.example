DATABASE_URL="postgresql://postgres:postgres@localhost:5432/real_estate_index"
NEXTAUTH_SECRET="change_me"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="ChangeMe123!"
NEXT_PUBLIC_MAP_LAT="32.0853"
NEXT_PUBLIC_MAP_LNG="34.7818"
NEXT_PUBLIC_MAP_ZOOM="11"

# Platform / runtime
PLATFORM=local              # local | aws
STORAGE_PROVIDER=local      # local | s3

# AWS S3 (production)
# S3_REGION=eu-north-1
# S3_BUCKET=aradre-assets
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Resend (transactional email — contact form + inquiry notifications)
# Without RESEND_API_KEY the contact form returns an error and inquiry
# notifications are skipped (the inquiry itself is still saved).
RESEND_API_KEY=
RESEND_FROM_EMAIL="noreply@aradre.com"
RESEND_TO_EMAIL="avi@aradre.com"   # contact-form recipient and inquiry fallback when no per-property seller is set
