# ──────────────────────────────────────────────────────────────────
# Test environment — used by `npm run test:e2e` only.
# A separate Postgres DB so production data is never touched.
# Create it once with:  createdb real_estate_index_test
# ──────────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/real_estate_index_test"

# Storage stays local for tests so cascade-delete assertions can read the FS.
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./public/uploads-test

# NextAuth — ephemeral secret for tests
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=test-secret-not-for-production-use

# Resend — disabled in tests; the EmailLog row is the assertion target
RESEND_API_KEY=
EMAIL_DRY_RUN=1

# Test app port (matches dev:test script)
PORT=3100
