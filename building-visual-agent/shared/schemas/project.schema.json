{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectInput",
  "type": "object",
  "required": ["project", "buildings"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["id", "name", "images"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "images": {
          "type": "object",
          "properties": {
            "front": { "type": "string" },
            "left": { "type": "string" },
            "right": { "type": "string" },
            "back": { "type": "string" },
            "gallery": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "buildings": { "type": "array" },
    "selectedApartmentId": { "type": "string" }
  }
}
